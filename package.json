{
  "name": "levelup",
  "version": "1.0.0",
  "description": "LevelUp — The Engineering Learning Engine",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "start": "docker-compose up --build",
    "stop": "docker-compose down",
    "stop:volumes": "docker-compose down -v",
    "logs": "docker-compose logs -f",
    "logs:server": "docker-compose logs -f server",
    "logs:client": "docker-compose logs -f client",
    "logs:executor": "docker-compose logs -f executor",
    "db:migrate": "docker-compose exec server npx prisma migrate dev",
    "db:seed": "docker-compose exec server npx prisma db seed",
    "db:studio": "docker-compose exec server npx prisma studio",
    "db:reset": "docker-compose exec server npx prisma migrate reset --force"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
